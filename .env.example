# Alpaca paper trading keys (dashboard -> Paper Trading -> API Keys)
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# Financial Modeling Prep (free plan is enough)
FMP_API_KEY=

# paper (default) or live. Live also needs /golive confirmation in Telegram.
TRADING_MODE=paper
# Only needed when TRADING_MODE=live
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=

ANTHROPIC_API_KEY=
# Optional, defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=

TELEGRAM_TOKEN=
# Your private chat id with Next Open's Telegram account (only this chat is served)
TELEGRAM_OWNER_CHAT_ID=

# Optional
DATABASE_PATH=data/next-open.db
# Nightly backups (02:00 New York), kept 14 days
BACKUP_DIR=data/backups
# Optional dead man's switch (e.g. healthchecks.io, period 5 min): alerts you if the whole server goes quiet
HEALTHCHECK_PING_URL=
LOG_LEVEL=info
# Optional JSON file overriding risk, universe and tax settings (see src/config/schema.ts)
CONFIG_PATH=
